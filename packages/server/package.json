{
  "name": "@vtt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts test/unit/*.test.ts test/feature/*.test.ts test/regression/*.test.ts",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:feature": "tsx --test test/feature/*.test.ts",
    "test:regression": "tsx --test test/regression/*.test.ts",
    "test:fast": "tsx --test test/unit/*.test.ts test/feature/*.test.ts",
    "test:legacy": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@vtt/shared": "^0.1.0",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
