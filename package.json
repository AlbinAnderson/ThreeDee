{
  "name": "pf1e-simplifier",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w @vtt/server\" \"npm run dev -w @vtt/client\"",
    "build": "npm run build -w @vtt/client",
    "start": "npm run start -w @vtt/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "vtt": "npm run --silent cli -w @vtt/server --",
    "test": "npm run test -w @vtt/server",
    "test:unit": "npm run test:unit -w @vtt/server",
    "test:feature": "npm run test:feature -w @vtt/server",
    "test:regression": "npm run test:regression -w @vtt/server",
    "test:fast": "npm run test:fast -w @vtt/server",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2"
  }
}
